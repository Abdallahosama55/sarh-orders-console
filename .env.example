# `npm run setup` copies this file to .env and fills JWT_SECRET with a random value.
# Never commit .env.

# Required: at least 32 random characters. The API refuses to start without it.
JWT_SECRET=

PORT=3001
# Relative paths are resolved from the repository root.
DATABASE_PATH=data/orders.db
# Browser origin allowed to send state-changing requests (the Vite dev server).
APP_ORIGIN=http://localhost:5173
# Day boundaries for "revenue today" on the stats page.
BUSINESS_TIME_ZONE=Asia/Riyadh
# Deliberate latency of GET /api/orders/stats (optional task O1), "min-max" in milliseconds.
STATS_DELAY_MS=3000-6000
# debug | info | warn | error | silent
LOG_LEVEL=info
